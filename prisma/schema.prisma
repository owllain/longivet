generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Citas agendadas desde el asistente multipaso del sitio.
model Appointment {
  id           String   @id @default(cuid())
  code         String   @unique // Código de confirmación LV-XXXXXX
  petName      String
  species      String // perro | gato | otro
  breed        String?
  ageYears     Float?
  service      String
  preferredVet String? // sin-preferencia | dra-solis | dr-rojas | dra-ferrara
  date         String // ISO YYYY-MM-DD
  timeSlot     String // HH:mm (24h)
  tutorName    String
  email        String
  phone        String
  notes        String?
  status       String   @default("CONFIRMADA") // CONFIRMADA | ATENDIDA | CANCELADA
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date, timeSlot])
  @@index([date])
}
